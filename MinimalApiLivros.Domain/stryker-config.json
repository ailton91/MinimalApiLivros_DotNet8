{
  "stryker-config": {
    "mutate": [
      "Entities/**/*.cs"
    ],
    "ignore-methods": [
      "*LogInformation*",
      "*LogWarning*",
      "*LogError*",
      "*ArgumentException*"
    ],
    "ignore-mutations": [
      "String"
    ],
    "reporters": [
      "html",
      "progress"
    ],
    "concurrency": 4
  }
}
